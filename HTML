<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Personal Portfolio</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #121212;\n            color: #ffffff;\n            margin: 0;\n            padding: 0;\n        }\n        header, footer {\n            background: #1e1e1e;\n            text-align: center;\n            padding: 1em;\n        }\n        section {\n            padding: 2em;\n        }\n        .container {\n            max-width: 800px;\n            margin: auto;\n        }\n        .skills, .projects {\n            display: flex;\n            flex-wrap: wrap;\n        }\n        .skill, .project {\n            background: #2e2e2e;\n            margin: 10px;\n            padding: 10px;\n            flex: 1;\n            min-width: 210px;\n        }\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            max-width: 400px;\n            margin: auto;\n        }\n        .contact-form input, .contact-form textarea {\n            margin: 5px 0;\n            padding: 10px;\n            border: none;\n            border-radius: 5px;\n        }\n        .contact-form button {\n            padding: 10px;\n            background: #6200ea;\n            color: white;\n            border: none;\n            border-radius: 5px;\n            cursor: pointer;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>Welcome to My Portfolio</h1>\n    </header>\n    <div class="container">\n        <section id="about">\n            <h2>About Me</h2>\n            <p>Hello! I am a passionate developer with a love for creating web applications.</p>\n        </section>\n        <section id="skills">\n            <h2>Skills</h2>\n            <div class="skills">\n                <div class="skill">HTML</div>\n                <div class="skill">CSS</div>\n                <div class="skill">JavaScript</div>\n                <div class="skill">React</div>\n            </div>\n        </section>\n        <section id="projects">\n            <h2>Projects</h2>\n            <div class="projects">\n                <div class="project">Project 1</div>\n                <div class="project">Project 2</div>\n                <div class="project">Project 3</div>\n            </div>\n        </section>\n        <section id="contact">\n            <h2>Contact</h2>\n            <form class="contact-form">\n                <input type="text" placeholder="Your Name" required />\n                <input type="email" placeholder="Your Email" required />\n                <textarea placeholder="Your Message" required></textarea>\n                <button type="submit">Send Message</button>\n            </form>\n        </section>\n    </div>\n    <footer>\n        <p>&copy; 2026 My Portfolio</p>\n    </footer>\n    <script>\n        document.querySelector('.contact-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n            alert('Message sent!');\n        });\n    </script>\n</body>\n</html>
